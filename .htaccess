RewriteEngine On

# Redirect www to non-www with https
RewriteCond %{HTTP_HOST} ^www\.ecoprism\.com [NC]
RewriteRule ^(.*)$ https://ecoprism.com/$1 [L,R=301]

# Redirect http to https (non-www check)
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Force non-www and https for all traffic
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [L,R=301]

# Force California explained page to serve HTML (avoids wrong extensionless file on server)
RewriteRule ^resources/california-climate-laws-explained/?$ /resources/california-climate-laws-explained.html [L]

# CSRD Reporting page at site root — /csrd-reporting and /csrd-reporting/ serve csrd-reporting.html
RewriteRule ^csrd-reporting/?$ /csrd-reporting.html [L]

# CSRD marketing page at site root — /csrd and /csrd/ serve csrd.html (not whitepaper, not /csrd-reporting/)
RewriteRule ^csrd/?$ /csrd.html [L]

# CSRD Adoption intelligence page at site root
RewriteRule ^csrd-adoption/?$ /csrd-adoption.html [L]

# Our Team page at site root
RewriteRule ^our-team/?$ /our-team.html [L]
RewriteRule ^teams/?$ /our-team [R=301,L]

# ===== Remove .html extension from all URLs site-wide =====
# Redirect .html URLs to extensionless URLs (301 permanent redirect)
# This rule catches requests with .html and redirects them to clean URLs
RewriteCond %{THE_REQUEST} \s/+[^\s?]*\.html[\s?] [NC]
RewriteCond %{REQUEST_URI} !^/v3/ [NC]
RewriteRule ^(.+)\.html$ /$1 [R=301,L]

# Internally add .html extension if file exists (only for requests without .html)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !^/v3/ [NC]
RewriteCond %{REQUEST_URI} !\.html$ [NC]
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [L]
# ===== End of HTML removal rules =====

# ===== Normalize double slashes =====
# Redirect URLs with double slashes (//) to single slash
# This handles cases like /ecobot// -> /ecobot/ -> /ecobot (after trailing slash removal)
# Must come before trailing slash removal to properly handle double trailing slashes
# This will normalize multiple slashes anywhere in the URL
RewriteCond %{REQUEST_URI} ^(.*)//+(.*)$
RewriteRule . %1/%2 [R=301,L]
# ===== End of double slash normalization =====

# ===== Remove tracking query parameters (trk, utm, ref) =====
# Redirect URLs with tracking parameters to clean URLs (without query string)
RewriteCond %{QUERY_STRING} ^.*(trk|utm_source|utm_medium|utm_campaign|utm_id|utm_term|utm_content|ref)=.* [NC]
RewriteRule ^(.*)$ https://ecoprism.com%{REQUEST_URI}? [R=301,L]
# ===== End of tracking parameter removal =====

# ===== Remove trailing slashes (301 permanent redirect) =====
# Redirect URLs with trailing slashes to non-slash versions
# Exclude root, v3, and folders that should keep trailing slashes
# Also exclude directory index pages (insights, whitepapers, events, careers)
RewriteCond %{REQUEST_URI} !^/$
RewriteCond %{REQUEST_URI} !^/v3/
RewriteCond %{REQUEST_URI} !^/csrd-reporting/?$
RewriteCond %{REQUEST_URI} !^/csrd/?$
RewriteCond %{REQUEST_URI} !^/microsoft-partners
RewriteCond %{REQUEST_URI} !^/resources/case-studies
# Exclude /resources/ directory (redirected separately)
RewriteCond %{REQUEST_URI} !^/resources/?$
RewriteCond %{REQUEST_URI} !^/resources/insights/?$
RewriteCond %{REQUEST_URI} !^/resources/whitepapers/?$
RewriteCond %{REQUEST_URI} !^/events/?$
RewriteCond %{REQUEST_URI} !^/news/?$
RewriteCond %{REQUEST_URI} !^/careers/?$
RewriteCond %{REQUEST_URI} (.+)/$
RewriteRule ^(.+)/$ /$1 [R=301,L]
# ===== End of trailing slash removal =====

# ===== Directory index serving =====
# Apache's DirectoryIndex directive automatically serves index.html for directories
# The trailing slash exclusion rules above ensure /resources/insights/ and /resources/whitepapers/
# keep their trailing slashes and are handled correctly by DirectoryIndex
# No rewrite rule needed here - Apache handles it natively
# ===== End of directory index serving =====

